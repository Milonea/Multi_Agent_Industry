{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-industry.example/schemas/persona-settings.schema.json",
  "title": "Persona Settings",
  "description": "Presentation-only shared or user-scoped persona settings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "profiles",
    "default_profile_id",
    "assignments"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "global"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "profiles": {
            "additionalProperties": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "identity_data"
                    ]
                  },
                  {
                    "required": [
                      "source"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "enum": [
        "global",
        "personal"
      ]
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "default_profile_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "assignments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "roles"
      ],
      "properties": {
        "agents": {
          "$ref": "#/$defs/assignments"
        },
        "roles": {
          "$ref": "#/$defs/assignments"
        }
      }
    },
    "presentation_policy": {
      "$ref": "#/$defs/presentation_policy"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "locale",
        "style",
        "tone_tags"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "style": {
          "type": "string",
          "maxLength": 500
        },
        "tone_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identity_data": {
          "type": "object",
          "description": "Rich presentation identity data allowed only in private personal settings."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "records"
          ],
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "record_id",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "record_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "assignments": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identifier"
      }
    },
    "presentation_policy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Presentation-only wording rules. They cannot grant permissions or change routing.",
      "properties": {
        "rules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "casual": {
              "enum": [
                "off",
                "low",
                "medium_low",
                "medium",
                "high"
              ]
            },
            "coding": {
              "enum": [
                "off",
                "low",
                "medium_low",
                "medium",
                "high"
              ]
            },
            "validation": {
              "enum": [
                "off",
                "low",
                "medium_low",
                "medium",
                "high"
              ]
            },
            "security": {
              "enum": [
                "off",
                "low",
                "medium_low"
              ]
            },
            "destructive_operation": {
              "enum": [
                "off",
                "low",
                "medium_low"
              ]
            }
          }
        },
        "dialogue_budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trivial_task": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "normal_task": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "complex_task": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "critical_validation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        }
      }
    }
  }
}
