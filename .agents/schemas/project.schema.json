{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi-agent-industry/project-v1",
  "title": "관리 프로젝트 설정 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "purpose", "repository", "agent_routes", "validation_profile", "external_services"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "purpose": { "type": "string", "minLength": 1 },
    "repository": { "type": ["string", "null"], "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "agent_routes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" }
    },
    "validation_profile": { "type": "string", "minLength": 1 },
    "external_services": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
