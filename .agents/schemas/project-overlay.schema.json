{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi-agent-industry/project-overlay-v1",
  "title": "개인 프로젝트 오버레이 v1",
  "description": "사용자 전용 파일에만 두는 프로젝트 매핑. 등록된 Agent를 선택하고 작업을 좁힐 뿐 권한을 부여하지 않습니다. 교차 검증(Agent·Role·프로필 존재, 경로 중복, hold Agent 권한)과 권한 키 차단은 agent_runtime.project_overlay가 수행합니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "projects"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scope": { "const": "personal" },
    "projects": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 300 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_agent_id", "status"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "worktree_roots": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/absolutePath" } },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9_.-]{1,100}$" },
        "owner_agent_id": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["active", "hold", "inventory_only"] },
        "hold_agent_id": { "$ref": "#/$defs/identifier" },
        "persona_assignments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agents": { "type": "object", "propertyNames": { "$ref": "#/$defs/identifier" }, "additionalProperties": { "$ref": "#/$defs/identifier" } },
            "roles": { "type": "object", "propertyNames": { "$ref": "#/$defs/identifier" }, "additionalProperties": { "$ref": "#/$defs/identifier" } }
          }
        },
        "constraints": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/shortText" } },
        "validation": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
        },
        "manual_gates": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/shortText" } },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "agent"],
          "properties": {
            "provider": { "const": "orca" },
            "agent": { "enum": ["codex", "claude"] },
            "orca_project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:/_.@-]{0,199}$" },
            "workspace": { "enum": ["new-top-level", "existing"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "hold" } }, "required": ["status"] },
          "then": { "required": ["hold_agent_id"] },
          "else": { "not": { "required": ["hold_agent_id"] } }
        }
      ]
    }
  }
}
