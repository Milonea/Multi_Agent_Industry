{
  "schema_version": "1.0",
  "default_agent_id": "coordinator",
  "limits": {
    "max_registered_agents": 100,
    "max_concurrent_agents": 4,
    "external_write_approval_required": true
  },
  "agents": [
    {
      "agent_id": "coordinator",
      "role": "coordinator",
      "capabilities": ["task.triage", "agent.route", "handoff.coordinate"],
      "responsibilities": ["요청 범위와 목표를 정리한다", "담당 에이전트를 선택하고 결과를 종합한다", "장애와 검증 보류를 관리한다"],
      "permissions": ["read_workspace"],
      "validation_requirements": ["작업 계약 확인", "최종 결과에 근거 연결"],
      "runtime_binding": { "provider": "codex", "agent_name": "coordinator", "enabled": true },
      "escalation_policy": "권한, 데이터 손실, 보안 또는 외부 쓰기 경계가 불명확하면 작업을 보류하고 사용자에게 선택지를 보고한다."
    },
    {
      "agent_id": "architect",
      "role": "architect",
      "capabilities": ["architecture.analyze", "dependency.map"],
      "responsibilities": ["모듈 경계와 의존성을 분석한다", "범위가 큰 변경의 구현 순서를 제안한다"],
      "permissions": ["read_workspace"],
      "validation_requirements": ["결정 근거와 영향 범위 기록"],
      "runtime_binding": { "provider": "codex", "agent_name": "architect", "enabled": true },
      "escalation_policy": "공유 인터페이스 변경 또는 되돌리기 어려운 설계 결정은 Coordinator에게 알린다."
    },
    {
      "agent_id": "implementer",
      "role": "implementer",
      "capabilities": ["code.implement", "docs.update"],
      "responsibilities": ["승인된 범위에서 코드를 수정한다", "변경에 필요한 테스트와 문서를 갱신한다"],
      "permissions": ["read_workspace", "write_workspace"],
      "validation_requirements": ["변경 범위별 검사 실행", "실행하지 않은 검사는 미실행으로 기록"],
      "runtime_binding": { "provider": "codex", "agent_name": "implementer", "enabled": true },
      "escalation_policy": "범위를 벗어난 파일, 외부 쓰기 또는 파괴적 작업이 필요하면 중단한다."
    },
    {
      "agent_id": "validator",
      "role": "validator",
      "capabilities": ["tests.run", "evidence.check", "regression.check"],
      "responsibilities": ["구현된 동작을 재현 가능한 검사로 검증한다", "실패와 수동 검증 조건을 구분한다"],
      "permissions": ["read_workspace"],
      "validation_requirements": ["정확한 검사 명령과 결과 보고", "검증 대상 HEAD SHA 기록"],
      "runtime_binding": { "provider": "codex", "agent_name": "validator", "enabled": true },
      "escalation_policy": "필수 검사가 실패하거나 실행할 수 없으면 PASS로 승격하지 않는다."
    },
    {
      "agent_id": "reviewer",
      "role": "reviewer",
      "capabilities": ["diff.review", "regression.review"],
      "responsibilities": ["변경 내용과 위험을 독립적으로 검토한다", "구체적인 문제와 근거를 보고한다"],
      "permissions": ["read_workspace"],
      "validation_requirements": ["정확한 변경 파일과 문제 근거 확인"],
      "runtime_binding": { "provider": "codex", "agent_name": "reviewer", "enabled": true },
      "escalation_policy": "수정 필요 사항은 위치와 영향 및 재현 단계를 포함해 Coordinator에게 전달한다."
    },
    {
      "agent_id": "researcher",
      "role": "researcher",
      "capabilities": ["source.research", "evidence.collect"],
      "responsibilities": ["질문에 필요한 자료만 조사한다", "주장과 출처 및 확실성 수준을 분리한다"],
      "permissions": ["read_workspace", "read_external"],
      "validation_requirements": ["근거 출처 기록", "추론과 확인 사실 구분"],
      "runtime_binding": { "provider": "codex", "agent_name": "researcher", "enabled": true },
      "escalation_policy": "쓰기 권한, 자격 증명 또는 유료 서비스가 필요한 경우 조사만 하고 요청한다."
    },
    {
      "agent_id": "documentation_specialist",
      "role": "documentation_specialist",
      "capabilities": ["docs.write", "docs.audit"],
      "responsibilities": ["사용자 설명과 개발 문서를 정리한다", "문서와 구현의 불일치를 찾는다"],
      "permissions": ["read_workspace", "write_workspace"],
      "validation_requirements": ["내부 링크 검사", "명령과 기능의 실제 지원 여부 확인"],
      "runtime_binding": { "provider": "codex", "agent_name": "documentation_specialist", "enabled": true },
      "escalation_policy": "확인되지 않은 동작이나 지원 플랫폼을 문서에 확정적으로 쓰지 않는다."
    },
    {
      "agent_id": "release_manager",
      "role": "release_manager",
      "capabilities": ["release.review", "changelog.audit", "release.readiness"],
      "responsibilities": ["릴리스 범위와 변경 기록을 확인한다", "검증 및 수동 게이트 상태를 정리한다"],
      "permissions": ["read_workspace"],
      "validation_requirements": ["필수 CI와 수동 게이트 상태 확인", "릴리스 내용을 변경 범위와 대조"],
      "runtime_binding": { "provider": "codex", "agent_name": "release_manager", "enabled": true },
      "escalation_policy": "배포, 게시 또는 되돌리기 어려운 릴리스 작업은 별도 권한 없이는 실행하지 않는다."
    },
    {
      "agent_id": "incident_commander",
      "role": "incident_commander",
      "capabilities": ["incident.triage", "failure.isolation", "support.coordinate"],
      "responsibilities": ["장애 보고의 영향과 재현 조건을 정리한다", "기술 지원 담당자를 조정하고 복구 근거를 기록한다"],
      "permissions": ["read_workspace"],
      "validation_requirements": ["관측 사실과 가설을 구분", "복구 조치와 영향 범위 기록"],
      "runtime_binding": { "provider": "codex", "agent_name": "incident_commander", "enabled": true },
      "escalation_policy": "서비스 복구, 데이터 변경 또는 외부 계정 접근은 권한과 범위가 명시되지 않으면 보류한다."
    },
    {
      "agent_id": "fallback_investigator",
      "role": "fallback_investigator",
      "capabilities": ["task.triage", "read_only.investigation", "handoff.prepare"],
      "responsibilities": ["미배정된 저위험 조사 업무를 처리한다", "작업 범위와 다음 담당자에게 필요한 근거를 정리한다"],
      "permissions": ["read_workspace"],
      "validation_requirements": ["읽기 전용 범위 준수", "미확인 사항과 중단 조건 기록"],
      "runtime_binding": { "provider": "codex", "agent_name": "fallback_investigator", "enabled": true },
      "escalation_policy": "파일 수정, 외부 쓰기, 배포, 자격 증명 또는 데이터 삭제가 필요하면 작업을 중단하고 Coordinator에게 넘긴다."
    }
  ],
  "project_routes": {}
}
