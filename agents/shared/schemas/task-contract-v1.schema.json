{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi-agent-industry/task-contract-v1",
  "title": "플랫폼 중립 작업 계약 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "requested_by",
    "target_project",
    "objective",
    "context",
    "scope",
    "allowed_changes",
    "forbidden_changes",
    "acceptance_criteria",
    "validation_required",
    "approval_gate",
    "expected_report"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^[0-9]{8}-[A-Za-z0-9_-]+$" },
    "requested_by": { "type": "string", "minLength": 1 },
    "target_project": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "context": { "type": "array", "items": { "type": "string" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowed_changes": { "type": "array", "items": { "type": "string" } },
    "forbidden_changes": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "validation_required": { "type": "array", "items": { "type": "string" } },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": ["none", "user_approval_required", "manual_validation", "external_write", "security_or_data"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "expected_report": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "parent_task_id": { "type": ["string", "null"] },
    "idempotency_key": { "type": ["string", "null"] }
  }
}
