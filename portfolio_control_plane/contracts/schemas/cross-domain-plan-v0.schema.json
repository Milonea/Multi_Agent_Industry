{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-agent-industry.invalid/contracts/cross-domain-plan-v0.schema.json",
  "title": "도메인 간 작업 계획 v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "created_at", "status", "preview", "approval_required", "stages", "risk", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "plan_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["approval_required", "approved", "HOLD_MANUAL"]},
    "preview": {"type": "boolean"},
    "approval_required": {"type": "boolean"},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]},
    "approval_scope": {"type": ["string", "null"], "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "capability", "reason", "provenance"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["ready", "verified", "blocked", "skipped"]},
          "capability": {"type": "string", "minLength": 1},
          "reason": {"type": ["string", "null"]},
          "provenance": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_writes", "manual_gates", "rollback"],
      "properties": {
        "external_writes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "manual_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {
        "required": ["approved_by", "approved_at", "approval_scope"],
        "properties": {
          "preview": {"const": false},
          "approval_required": {"const": true},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "minLength": 1},
          "approval_scope": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["approval_required", "HOLD_MANUAL"]}}},
      "then": {
        "properties": {
          "preview": {"const": true},
          "approval_required": {"const": true},
          "approved_by": {"type": "null"},
          "approved_at": {"type": "null"},
          "approval_scope": {"type": "null"}
        }
      }
    }
  ]
}
